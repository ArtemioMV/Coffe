# ============================================================
# Restaurante campestre · configuración local
# Copia este archivo a ".env" y ajusta los valores reales.
#   cp .env.example .env
# El archivo .env NUNCA se sube a git (está en .gitignore).
# ============================================================

# ---- Next.js / API REST ----
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Restaurante campestre
AUTH_SECRET=generar-con-npm-run-env-setup
SESSION_HOURS=12
NEXT_PORT=3000

# ---- PostgreSQL (arquitectura nueva) ----
POSTGRES_USER=restaurant
POSTGRES_DB=restaurant
POSTGRES_PASSWORD=generar-con-npm-run-env-setup
POSTGRES_PORT=55432
DATABASE_URL=postgresql://restaurant:CAMBIAR@127.0.0.1:55432/restaurant?schema=public

# ---- Redis: caché y colas separados ----
REDIS_CACHE_URL=redis://127.0.0.1:56379
REDIS_QUEUE_URL=redis://127.0.0.1:56380
REDIS_CACHE_PORT=56379
REDIS_QUEUE_PORT=56380

# ---- Semilla local: nunca habilitar en producción ----
SEED_DEMO=false
SEED_PASSWORD=generar-con-npm-run-env-setup

# ---- Identidad fiscal: completar antes de habilitar libro/emisión ----
BUSINESS_NAME=
BUSINESS_RUC=
BUSINESS_ADDRESS=
CLAIMS_EMAIL=

# ---- Reseñas públicas de Google Maps (opcional, solo en servidor) ----
GOOGLE_PLACES_PLACE_ID=ChIJ89vGHLs9rZERoYypHBYH20s
GOOGLE_PLACES_API_KEY=

# ---- Correo del worker: sin valores, conserva tareas pendientes ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Impresión y emisión electrónica ----
TICKET_WIDTH_MM=80
INVOICE_PROVIDER=disabled
# El ticket interno no es boleta/factura electrónica.
