generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
  CUSTOMER
}

enum Station {
  KITCHEN
  BAR
}

enum OrderStatus {
  AWAITING_WAITER
  PENDING
  PREPARING
  READY
  DELIVERED
  REJECTED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  active       Boolean  @default(true)
  points       Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  attentions   Attention[]
  orders       Order[]   @relation("CustomerOrders")
  payments     Payment[]
  pointEntries PointEntry[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  active   Boolean   @default(true)
  position Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  price       Decimal     @db.Decimal(12, 2)
  categoryId  String
  station     Station     @default(KITCHEN)
  active      Boolean     @default(true)
  available   Boolean     @default(true)
  category    Category    @relation(fields: [categoryId], references: [id])
  items       OrderItem[]
  recipe      RecipeItem[]
  @@index([categoryId, active])
}

model DiningTable {
  id         String      @id @default(cuid())
  name       String      @unique
  zone       String      @default("Jardín")
  seats      Int         @default(4)
  active     Boolean     @default(true)
  qrToken    String      @unique
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  attentions Attention[]
}

model Attention {
  id        String      @id @default(cuid())
  tableId   String
  waiterId  String
  openedAt  DateTime    @default(now()) @db.Timestamptz(3)
  closedAt  DateTime?   @db.Timestamptz(3)
  table     DiningTable @relation(fields: [tableId], references: [id])
  waiter    User        @relation(fields: [waiterId], references: [id])
  orders    Order[]
  @@index([tableId, closedAt])
}

model Order {
  id              String      @id @default(cuid())
  number          Int         @unique @default(autoincrement())
  attentionId     String?
  customerId      String?
  mode            String      @default("mesa")
  guestName       String      @default("")
  notes           String      @default("")
  status          OrderStatus @default(AWAITING_WAITER)
  version         Int         @default(0)
  total           Decimal     @db.Decimal(12, 2)
  trackingHash    String      @unique
  idempotencyKey  String      @unique
  requestHash     String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  acknowledgedAt  DateTime?   @db.Timestamptz(3)
  attention       Attention?  @relation(fields: [attentionId], references: [id])
  customer        User?       @relation("CustomerOrders", fields: [customerId], references: [id])
  items           OrderItem[]
  history         OrderHistory[]
  payments        Payment[]
  pointEntries    PointEntry[]
  rating          Rating?
  stockMovements  StockMovement[]
  @@index([status, createdAt])
  @@index([attentionId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  name        String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  notes       String  @default("")
  station     Station
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  @@index([orderId])
}

model OrderHistory {
  id        String   @id @default(cuid())
  orderId   String
  actorId   String?
  status    String
  reason    String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id])
  @@index([orderId, createdAt])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  actorId        String
  amount         Decimal  @db.Decimal(12, 2)
  method         String
  reference      String   @default("")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  order          Order    @relation(fields: [orderId], references: [id])
  actor          User     @relation(fields: [actorId], references: [id])
  @@index([orderId])
}

model PointEntry {
  id        String   @id @default(cuid())
  userId    String
  orderId   String
  points    Int
  kind      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  @@unique([orderId, kind])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?
  @@index([processedAt, createdAt])
}

model Notification {
  id             String    @id @default(cuid())
  sequence       Int       @unique @default(autoincrement())
  eventId        String
  userId         String
  orderId        String?
  title          String
  body           String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  readAt         DateTime? @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)
  @@unique([eventId, userId])
  @@index([userId, sequence])
}

model Ingredient {
  id       String          @id @default(cuid())
  name     String          @unique
  unit     String
  stock    Decimal         @default(0) @db.Decimal(14, 3)
  minimum  Decimal         @default(0) @db.Decimal(14, 3)
  active   Boolean         @default(true)
  recipes  RecipeItem[]
  movements StockMovement[]
}

model RecipeItem {
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  @@id([productId, ingredientId])
}

model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  orderId      String?
  actorId      String?
  quantity     Decimal    @db.Decimal(14, 3)
  kind         String
  reason       String
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  order        Order?     @relation(fields: [orderId], references: [id])
  @@index([ingredientId, createdAt])
}

model Claim {
  id             String   @id @default(cuid())
  number         Int      @unique @default(autoincrement())
  accessHash     String   @unique
  kind           String
  name           String
  document       String
  email          String
  phone          String
  address        String
  representative String
  service        String
  amount         Decimal? @db.Decimal(12, 2)
  detail         String
  request        String
  provider       Json
  status         String   @default("RECIBIDO")
  response       String?
  respondedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
}

model Suggestion {
  id        String   @id @default(cuid())
  message   String
  contact   String
  status    String   @default("RECIBIDO")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model Rating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  score     Int
  comment   String   @default("")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order     Order    @relation(fields: [orderId], references: [id])
}

model SiteSocial {
  id            Int     @id @default(1)
  facebook      String?
  instagram     String?
  tiktok        String?
  instagramPost String?
  tiktokVideo   String?
  version       Int     @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  resource  String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
